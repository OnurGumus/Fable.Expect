<Project>
    <PropertyGroup>
        <!-- Overridden by the release workflow, which passes -p:Version from the tag it
             was triggered by. What is written here is what a local `dotnet pack`
             produces.

             (No double hyphen in these comments. MSBuild parses this file as XML, where
             two of them is a parse error that fails every project in the directory.) -->
        <Version>2.0.0</Version>
        <PackageVersion>$(Version)</PackageVersion>

        <!-- The .Unofficial id is the point of the fork: this is somebody else's library,
             republished so two fixes can be used before upstream merges them. Upstream
             last released 1.1.1 and was last touched in November 2021. LICENSE is packed
             unchanged; if the PRs land, this gets deprecated on NuGet pointing at the
             original.

             One Authors entry, not two: NuGet splits this field on semicolons. -->
        <Authors>Alfonso García-Caro Núñez and Fable.Expect contributors (unofficial build published by Onur Gümüş)</Authors>
        <Copyright>Copyright (c) Alfonso García-Caro Núñez and Fable.Expect contributors</Copyright>
        <PackageReleaseNotes>Unofficial fork of Fable.Expect. Toolchain moved to .NET 10, Fable 5, Fable.Core 4 and Elmish 5. Two fixes for running under Fable 5: the HTML comment regex no longer uses an illegal identity escape (the module threw SyntaxError on import), and AssertionError sets its stack on this rather than super (V8 rejected the latter, so every failing assertion raised the wrong error).</PackageReleaseNotes>

        <!-- Both of these pointed elsewhere: the project url at fable.io and the
             repository url at fable-compiler/Fable, the compiler rather than this
             library. SourceLink resolves sources through RepositoryUrl, so it was
             sending debuggers to the wrong repository. -->
        <PackageProjectUrl>https://github.com/OnurGumus/Fable.Expect</PackageProjectUrl>
        <RepositoryUrl>https://github.com/OnurGumus/Fable.Expect.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageIcon>fable_logo.png</PackageIcon>
        <PackageTags>fsharp;fable;testing;test;javascript;f#;js;unofficial</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- For SourceLink. See: https://github.com/dotnet/sourcelink#using-source-link-in-net-projects -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)\..\fable_logo.png" Pack="true" Visible="false" PackagePath="" />
        <None Include="$(MSBuildThisFileDirectory)\..\LICENSE" Pack="true" Visible="false" PackagePath=""/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All" />
    </ItemGroup>
</Project>
